# General files to ignore
*.bak
*.rpt
*.smsg
*.qws

# Quartus project database
# These files are generated by the compiler and are very large
/db/
/incremental_db/

# Quartus output files (bitstreams, reports, etc.)
/output_files/

# ModelSim simulation cache and temporary files
# We ran into this problem ourselves!
/simulation/
*.vho
*.vht
modelsim.ini
transcript

# Misc Quartus files
*.qarlog
c5_pin_model.ini
*.qdf
